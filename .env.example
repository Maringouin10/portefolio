# Base de donnees SQLite (chemin dans le conteneur, monte en volume)
DATABASE_URL="file:./data/app.db"

# Secret utilise pour signer les sessions admin (chaine aleatoire longue)
# Generer avec: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Aucun identifiant admin a configurer ici : au premier acces a /admin,
# un ecran de creation de compte s'affiche. Le mot de passe que vous saisissez
# est hache (bcrypt) et enregistre en base automatiquement.
