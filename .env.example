# Base de donnees SQLite (chemin dans le conteneur, monte en volume)
DATABASE_URL="file:./data/app.db"

# Secret utilise pour signer les sessions admin (chaine aleatoire longue)
# Generer avec: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Identifiants admin
ADMIN_EMAIL="admin@example.com"
# Generer avec: npm run hash-password -- "votre-mot-de-passe"
# Avec Docker Compose, laissez les $ tels quels (non echappes).
# En local sans Docker (npm run dev / npm start), echappez chaque $ en \$
# (voir README) sinon Next.js tronquera le hash.
ADMIN_PASSWORD_HASH="generate-me"
